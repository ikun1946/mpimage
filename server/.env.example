# 监听地址与端口
HOST=127.0.0.1
PORT=8787

# 对外可访问的后端地址；留空时按请求 Host 头自动推断
PUBLIC_BASE_URL=

# 上游 Magpie 网关
MAGPIE_BASE_URL=http://127.0.0.1:3425
MAGPIE_IMAGE_MODEL=codex/gpt-image-2
# 自由创作「AI 优化提示词」用的对话模型，和生图模型无关
MAGPIE_TEXT_MODEL=auto/deepseek-v4.1-flash

# 提示词优化的上游超时（毫秒）
PROMPT_OPTIMIZE_TIMEOUT_MS=120000

# 同时打向 Magpie 的生图请求上限（1–8）。前端默认逐张生成；
# 调大后可在批量页把「并行数」调到 2–4，服务端以此值兜底防刷爆上游。
IMAGE_CONCURRENCY=5

# 单次生成超时（毫秒）
IMAGE_TIMEOUT_MS=300000

# 提示词最大长度
MAX_PROMPT_LENGTH=12000

# 图片存储目录；留空则使用项目根目录下的 generated/
STORAGE_DIR=

# 风格库文件位置；留空则使用项目根目录下的 styles.json
STYLE_LIBRARY_PATH=

# 账号库与用量统计；留空则使用项目根目录下的 users.json / usage.json
USER_DATABASE_PATH=
USAGE_DATABASE_PATH=
PROJECT_DATABASE_PATH=

# 会话签名密钥；留空则每次启动随机生成（会话令牌落盘，登录状态不受影响）
SESSION_SECRET=

# 引导创建首个管理员的管理密钥；留空则禁用引导接口
ADMIN_SETUP_KEY=

# 版本检查：客户端「关于画境」与桌面端「检查更新…」都读这组配置
# 当前版本号；桌面端会注入 app.getVersion()，单独跑后端时才需要手写
APP_VERSION=
# GitHub 仓库（owner/repo），默认 ikun1946/mpimage
UPDATE_REPO=
# 自定义更新源；填了就不再查 GitHub，需返回 { version, notes?, downloadUrl?, pageUrl?, publishedAt? }
UPDATE_FEED_URL=
# GitHub token（可选）：发布源限流时用
UPDATE_TOKEN=
# 置 1 关闭更新检查，接口直接返回 disabled
UPDATE_CHECK_DISABLED=

# 允许跨域的前端来源，逗号分隔
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173
